{
  "name": "physics-fal",
  "version": "1.0.0",
  "private": true,
  "description": "Makes the files for the short film \"Physics\": voices, sounds, radio cut, animatic, mix and assembled cut for each scene, and its Kling clips on fal.ai.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pull": "node scripts/pull.js",
    "generate": "node scripts/generate.js",
    "voice": "node scripts/voice.js",
    "check": "node scripts/generate.js --section \"Cold open\" --dry-run",
    "sounds": "node scripts/sounds.js",
    "upload": "node scripts/upload.js",
    "radio": "node scripts/radio.js",
    "animatic": "node scripts/animatic.js",
    "mix": "node scripts/radio.js --mix",
    "assemble": "node scripts/assemble.js"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.76.0",
    "@fal-ai/client": "1.10.1",
    "@notionhq/client": "5.27.1",
    "dotenv": "18.0.9",
    "yaml": "2.9.1"
  }
}
