# Copy this file to .env and fill in the keys. .env is git-ignored:
# never commit the keys, paste them into chat or put them in Notion.

# fal.ai → API Keys
FAL_KEY=

# dev.runway.com → API Keys (for Kling 4.0)
RUNWAYML_API_SECRET=

# notion.so/profile/integrations → your "physics-fal" integration → Internal Integration Secret
NOTION_TOKEN=

# elevenlabs.io → Developers → API Keys (for the voices)
ELEVENLABS_API_KEY=

# Google Cloud project ID for Vertex AI frame generation. Authenticate locally with gcloud ADC.
GOOGLE_CLOUD_PROJECT=
